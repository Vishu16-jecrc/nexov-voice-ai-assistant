# NexovAI Voice AI Doctor Appointment Assistant Environment Config
# Copy this file to .env and insert your API keys if desired.
# Note: The system features an automatic built-in intelligent fallback mode,
# so the application runs out-of-the-box even without external API keys.

# ElevenLabs Configuration (Optional: for cloud neural voice TTS & STT)
# Sign up at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Google Gemini Configuration (Optional: for cloud LLM with Function Calling)
# Obtain a free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Server Host & Port
HOST=127.0.0.1
PORT=8000
